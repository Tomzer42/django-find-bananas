# Copy to .env (never commit it) or set these in your host's dashboard.

# --- Required in production ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-50-random-characters
DJANGO_ALLOWED_HOSTS=find-bananas.com,www.find-bananas.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://find-bananas.com,https://www.find-bananas.com
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
SITE_URL=https://find-bananas.com

# Number of proxies in front of the app (1 on Render/Fly/Heroku-like hosts).
DJANGO_TRUSTED_PROXY_COUNT=1

# --- Email (password reset) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Find Bananas <no-reply@find-bananas.com>

# --- Optional ---
# Shared cache once you run more than one instance.
# CACHE_URL=redis://...
# Google Analytics (only loaded after the visitor accepts).
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Daily switch time (defaults: 12h, Europe/Paris).
# EDITION_HOUR=12
# EDITION_TIMEZONE=Europe/Paris
# Ranked players needed before showing a percentile (default 20).
# RANKING_MIN_PLAYERS=20
# Raise to 31536000 (1 year) once HTTPS works on every subdomain.
# DJANGO_HSTS_SECONDS=3600
